    family-names: Foster
    alias: nichfoster
version: 0.21.0
date-released: 2026-10-26
license: GPL-3.0-or-later
repository-code: "https://github.com/nichfoster/ionomos"
url: "https://github.com/nichfoster/ionomos"
keywords:
  - proteomics
  - mass spectrometry
  - FragPipe
  - DIA-NN
  - limma
  - differential expression
  - chemoproteomics
  - isoDTB
  - TMT
